# virtualenvs and caches
.venv/
__pycache__/
*.pyc

# unzipped copies of source artefacts (regenerate with `make unpack`)
raw/

# generated documentation HTML (regenerate with `make wiki`)
wiki/

# upstream clone for the standards cross-check (regenerate with `make fetch`)
repo/

# extracted text of upstream PDFs
notes/

# editable-install metadata
*.egg-info/

# --- Excel add-in build artefacts (xll/) -----------------------------------
xll/*.o
xll/*.xll
xll/xll_age_grading_test
xll_test_tmp/
# case-fixing header symlinks, created by `make -C xll shim`
xll/shim/
# The generated sources ARE committed on purpose (a Windows/MSVC user must not
# need Python): xll/src/ag_tables_generated.h and xll/test/expected.h.
