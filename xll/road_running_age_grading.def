; road_running_age_grading.def — exports for the age-grading add-in.
;
; Excel needs the xlAuto* entry points plus XLCallVer (which the library does
; not define). The xll_rrag_* symbols are what Excel resolves from the procedure
; names passed to xlfRegister: the library strips the leading '_' of
; "_xll_rrag_grade" before registering, so the exported name is "xll_rrag_grade".
; On x64 there is no __stdcall name decoration, so these are plain names.
LIBRARY road_running_age_grading
EXPORTS
    XLCallVer
    xlAutoOpen
    xlAutoClose
    xlAutoAdd
    xlAutoRemove
    xlAutoFree
    xlAutoFree12
    xll_rrag_grade
    xll_rrag_gradedtime
    xll_rrag_factor
    xll_rrag_standard
    xll_rrag_timeforpct
    xll_rrag_block
    xll_rrag_tables
    xll_rrag_tableinfo
    xll_rrag_cacheinfo
    xll_rrag_cacheclear
    xll_rrag_lasterror
    xll_rrag_version
    ; The framework registers its own XLL.ALERT.LEVEL diagnostic. Its symbol
    ; relies on MSVC's #pragma XLLEXPORT, which mingw ignores, so xlAutoOpen
    ; would fail to register it -- and xlAutoOpen returns FALSE on any failed
    ; registration, which stops Excel loading the add-in at all. Export it.
    xll_alert_level_
